# Example variables for local Supabase CLI or deploy tooling.
# The static frontend reads only js/config.js (Supabase URL + anon/publishable key).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Set these as Supabase Edge Function secrets, NOT in browser files:
# SUPABASE_SECRET_KEYS is injected by the Supabase Edge runtime; never copy it into frontend files.
# RATE_LIMIT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# ALLOWED_ORIGIN=https://your-deployed-domain.example
